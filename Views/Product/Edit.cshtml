@model ProductDetails
<form asp-controller="Product" asp-action="Edit" method="post">
    <input asp-for="ProductId" type="hidden" />

    <div>

        <div>
            <label>Product Name</label>
            <input asp-for="ProductName" type="text" required />
        </div>

        <br />

        <div>
            <label>Category</label>
            <input asp-for="Category" type="text" required />
        </div>

        <br />

        <div>
            <label>Price</label>
            <input asp-for="Price" type="number" step="0.01" required />
        </div>

        <br />

        <div>
            <label>Quantity</label>
            <input asp-for="Quantity" type="number" required />
        </div>

        <br />

        <div>
            <label>Supplier</label>
            <input asp-for="Supplier" type="text" required />
        </div>

        <br />

        <div>
            <label>Expiry Date</label>
            <input asp-for="ExpiryDate" type="date" required />
        </div>

        <br />

        <div>
            <input class="btn-success" type="submit" value="Update" />
        </div>

    </div>


</form>